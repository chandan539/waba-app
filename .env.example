# Public HTTPS webhook Meta can reach. Required in production.
WABA_WEBHOOK_URL=https://api.example.com/api/whatsapp/webhook

# Brand text baked into utility templates at submit time (not a Meta variable).
WABA_BRAND=Your Brand
WABA_SHOP_URL=https://shop.example.com

# Admin origin used for Embedded Signup OAuth redirect.
WABA_ADMIN_ORIGIN=https://admin.example.com
WABA_OAUTH_PATH=/admin/waba
# Extra allowed admin origins, comma-separated.
WABA_OAUTH_ORIGINS=

# Used if WABA_WEBHOOK_URL is empty.
WABA_API_ORIGIN=https://api.example.com

# 10-digit mobiles get this country prefix.
WABA_DEFAULT_CC=91
WABA_GRAPH_VERSION=v26.0

# Meta App ID / secret / verify token are stored in WhatsAppAccount, not here.
# Never commit a System User token or App Secret.

# Optional Claude business answers; choose a currently available model for your API account.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Random server-only secret for expiring PNG booking tickets / provider-checkout QR images.
WABA_MEDIA_SIGNING_SECRET=

# Optional reference payment/calendar providers. Wire configuredAssistantAdapters() at boot.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CREATE_MEET=false

# Optional HTTPS endpoint in your deployment system. It receives the pinned GitHub release
# and an Idempotency-Key header. Set a server-only token for this endpoint.
WABA_UPDATE_HOOK_URL=
WABA_UPDATE_HOOK_TOKEN=

# WhatsApp Forms: register this exact admin-page redirect URL in your HubSpot app.
WABA_HUBSPOT_CLIENT_ID=
WABA_HUBSPOT_CLIENT_SECRET=
WABA_HUBSPOT_REDIRECT_URI=https://admin.example.com/admin/waba?wabix_hubspot=1
# Generate with openssl rand -hex 32 and preserve this key between releases.
WABA_HUBSPOT_TOKEN_KEY=
# Optional trusted HTTPS destination for forms that select Webhook.
WABA_FORMS_WEBHOOK_URL=
WABA_FORMS_WEBHOOK_TOKEN=

# Opt in to scheduled stable Wabix releases after wiring the host deployment hook.
WABA_AUTO_UPDATE=false
