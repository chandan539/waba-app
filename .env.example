# Public HTTPS webhook Meta can reach. Required in production.
WABA_WEBHOOK_URL=https://api.example.com/api/whatsapp/webhook

# Brand text baked into utility templates at submit time (not a Meta variable).
WABA_BRAND=Your Brand
WABA_SHOP_URL=https://shop.example.com

# Admin origin used for Embedded Signup OAuth redirect.
WABA_ADMIN_ORIGIN=https://admin.example.com
WABA_OAUTH_PATH=/admin/waba
# Extra allowed admin origins, comma-separated.
WABA_OAUTH_ORIGINS=

# Used if WABA_WEBHOOK_URL is empty.
WABA_API_ORIGIN=https://api.example.com

# 10-digit mobiles get this country prefix.
WABA_DEFAULT_CC=91
WABA_GRAPH_VERSION=v26.0

# Meta App ID / secret / verify token are stored in WhatsAppAccount, not here.
# Never commit a System User token or App Secret.
